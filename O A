package validaciones;
import java.util.Scanner;
/**
 *
 * @author pv-alumno
 */
public class Metodos {
    Scanner lector = new Scanner(System.in);
    public String recibirString(String recibir, Integer minimo, Integer maximo){
        String texto = "";
        boolean validacion = false;
        do{
            System.out.println("Ingrese "+recibir);
            texto = lector.nextLine();
            validacion = validarString(texto, minimo, maximo);
        }while(validacion != true);
        return texto;
    }
    
    public boolean validarString(String texto, Integer minimo, Integer maximo){
        String sinEspacios = texto.trim();
        if(sinEspacios.length() == 0){
            System.out.println("Texto vacío, intente nuevamente");
            return false;
        }
        
        if(sinEspacios.length() < minimo){
            System.out.println("son mínimo "+ minimo+" caracteres");
            return false;
        }
        
        if(sinEspacios.length() > maximo){
            System.out.println("son máximo "+ maximo+" caracteres");
            return false;
        }
        return true;
        
    }
    public String recibirFecha(String recibir, Integer minimo, Integer maximo) {
        String texto = "";
        boolean validacion = false;
        do{
            System.out.println("Ingrese " + recibir + "(dd/mm/yyyy)");
            texto = lector.nextLine();
            validacion = validarFecha(texto, minimo, maximo);
        }while(validacion != true);
        return texto;   
    }
    
}


































